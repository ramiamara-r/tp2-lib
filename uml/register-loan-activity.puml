@startuml
title UC-05 Register a loan

|Librarian|
start
:Identify the member\n(membership card);
|System|
:Check borrowing rights;
if (rights OK?) then (yes)
else (no)
  :Refuse the loan,\ndisplay the reason (3a);
  stop
endif

repeat
  |Librarian|
  :Scan the barcode of a copy;
  |System|
  if (copy available and\nnot reserved for another member?) then (yes)
    :Register the loan,\ncompute the due date;
  else (no)
    :Refuse this copy,\ndisplay the reason (5a);
  endif
  |Librarian|
repeat while (another copy?) is (yes) not (no)

|System|
:Print the receipt;
stop
@enduml
